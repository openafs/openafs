#!/usr/bin/perl
use warnings;
use strict;

use Getopt::Long;
use Pod::Usage;
use File::Copy;
use File::Path;
use File::Temp;
use File::Basename;
use Cwd;

my $help;
my $man;
my $tagPoint;
my $last;
my $relnotes = 0;
my $outDir = ".";
my $perVersionDir = 0;
my $errorCount = 0;
my $docTarball = 1;
my @compress = ();

my %compressors = (
    "gz" => "gzip",
    "bz2" => "bzip2",
    "xz" => "xz",
);

# Format warn messages.
$SIG{__WARN__} = sub {
    my $msg = shift;
    warn "warning: $msg";
};

# Find a command in the PATH.
sub which {
    my $command = shift;
    my @paths = split(/:/, $ENV{'PATH'});
    my $path;

    # Add some common locations for the commands we need.
    push(@paths, qw(/sbin /usr/bin /usr/local/bin));

    # Search for the command.
    foreach $path (@paths) {
        my $bin = File::Spec->catfile($path, $command);
        if (-x $bin) {
            return $bin;  # Return the first one found.
        }
    }
    return undef;
}

# Run a command.
#
# Arguments:
#   args - array reference of command line arguments
#   opts - options:
#      chdir    => directory to change to before running the command
#      stdin    => file name to redirect stdin from
#      stdout   => file name to redirect stdout to, or a scalar
#                  reference to store the output in, without the
#                  trailing newline
#      exitcode => if true, return the exit code instead of dying or
#                  warning when the command fails
#      warn     => if true, warn instead of die if the command fails
#                  (this option is ignored when exitcode is true)
#      quiet    => do not print the command before running it
#
# Returns the command exitcode (or -1 if terminated by a signal) when
# 'exitcode' option is true.
#
# Otherwise, returns true if the command succeeds. Dies with an error message
# if the command fails, unless the 'warn' option is given, in which case it
# prints the error message and returns false.
#
sub run {
    my ($args, %opts) = @_;
    my $command = join(' ', @$args);

    # Construct a command string for info and error messages.
    if (defined $opts{chdir}) {
        $command = "cd $opts{chdir} && $command";
    }
    if (defined $opts{stdin}) {
        $command .= " < $opts{stdin}";
    }
    if (defined $opts{stdout} && !ref $opts{stdout}) {
        $command .= " > $opts{stdout}";
    }

    # Print the command to be run, unless in quiet mode.
    if (!$opts{quiet}) {
        print "make-release: $command\n";
    }

    # Fork the process and execute the command. Create a pipe to read
    # the command's stdout when capturing output.
    my $fh;
    my $pid;
    if (defined $opts{stdout} && ref $opts{stdout}) {
        $pid = open($fh, '-|');
    } else {
        $pid = fork();
    }
    if (!defined $pid) {
        die "Failed to fork: $!\n";
    }
    if ($pid == 0) {
        # Child process.
        if (defined $opts{chdir}) {
            if (!chdir($opts{chdir})) {
                warn "Failed to change directory to $opts{chdir}: $!\n";
                exit 127;
            }
        }
        if (defined $opts{stdin}) {
            if (!open(STDIN, '<', $opts{stdin})) {
                warn "Failed to open $opts{stdin}: $!\n";
                exit 127;
            }
        }
        if (defined $opts{stdout} && !ref $opts{stdout}) {
            if (!open(STDOUT, '>', $opts{stdout})) {
                warn "Failed to open $opts{stdout}: $!\n";
                exit 127;
            }
        }
        exec { $args->[0] } @$args;
        warn "Failed to execute '$args->[0]': $!\n";
        exit 127;
    }
    # Parent process.
    if (defined $opts{stdout} && ref $opts{stdout}) {
        ${$opts{stdout}} = do { local $/; <$fh> };  # Slurp the output.
        chomp ${$opts{stdout}};
        close($fh);  # Waits for the child and sets $?.
    } else {
        waitpid($pid, 0);
    }

    my $error;
    my $signal;
    my $exitcode;
    if ($? & 127) {
        $signal = $? & 127;
        $exitcode = -1;
        $error = "'$command' died with signal $signal ($?)\n";
    } elsif ($? != 0) {
        $exitcode = $? >> 8;
        $error = "'$command' exited with code $exitcode ($?)\n";
    } else {
        $exitcode = 0;
    }

    if ($opts{exitcode}) {
        if (defined($signal)) {
            warn $error;
        }
        return $exitcode;
    }
    if ($exitcode == 0) {
        return 1;   # success
    }
    if ($opts{warn}) {
        warn $error;
        return 0;   # failed with warning
    }
    die $error;     # fatal
}

# Check for uncommitted changes
#
# Arguments:
#   toplevel - top-level git directory
#
# Returns true if uncommitted changes are found in the git index or worktree.
#
sub git_is_dirty {
    my $toplevel = shift;
    my $code;

    $code = run(["git", "diff-index", "--quiet", "--cached", "HEAD"],
                 chdir => $toplevel, quiet => 1, exitcode => 1);
    if ($code == 1) {
        return 1;  # dirty
    }
    if ($code != 0) {
        die "git diff-index failed with code $code\n";
    }
    $code = run(["git", "diff-files", "--quiet"],
                 chdir => $toplevel, quiet => 1, exitcode => 1);
    if ($code == 1) {
        return 1;  # dirty
    }
    if ($code != 0) {
        die "git diff-files failed with code $code\n";
    }
    return 0;  # clean
}

# Determine release version.
#
# Arguments:
#   toplevel - top-level git directory
#   commit   - commit reference
#
# Returns the release version of the named commit. Use the in-tree git-version
# script to find the version of HEAD, otherwise fall back to git describe.
#
sub find_version {
    my ($toplevel, $commit) = @_;
    my $version;

    if ($commit eq "HEAD") {
        my $dirty = 0;
        if (-f "$toplevel/.version") {
            warn "Using $toplevel/.version to determine version.\n";
            $dirty = git_is_dirty($toplevel);
        }
        run(["$toplevel/build-tools/git-version", $toplevel],
             stdout => \$version, quiet => 1);
        if (!$version or $version eq "UNKNOWN") {
            die "Failed to determine version of $commit.\n";
        }
        if ($version =~ s/-dirty$// || $dirty) {
            warn "Uncommitted changes found. " .
                 "These will not be included in the release.\n";
        }
    } else {
        run(["git", "describe", "--abbrev=4", $commit],
             stdout => \$version, quiet => 1);
        if (!$version) {
            die "Failed to describe $commit.\n";
        }
        $version =~ s/openafs-[^-]*-//;
        $version =~ s/_/./g;
    }
    print "Version is $version\n";
    return $version;
}

GetOptions(
    "help|?" => \$help,
    "man" => \$man,
    "tagpoint=s" => \$tagPoint,  # not used
    "last=s" => \$last,
    "relnotes" => \$relnotes,
    "destdir|dir=s" => \$outDir,
    "per-version-dir" => \$perVersionDir,
    "doc-tarball!" => \$docTarball,
    "compress=s" => \@compress,
) or pod2usage(2);

pod2usage(1) if $help;
pod2usage(-exitstatus => 0, -verbose => 2, -noperldoc => 1) if $man;

if (!@compress) {
    @compress = ("gz", "bz2");  # xz is not created by default.
}
foreach my $format (@compress) {
    if (!exists($compressors{$format})) {
        pod2usage(-exitval => 2, -message => "Unknown compression format: $format");
    }
}

my $commit = shift;
if (!$commit) {
    $commit = "HEAD";
} elsif ($commit eq "HEAD") {
    warn "The commit argument 'HEAD' is deprecated; " .
         "run make-release without it.\n";
} else {
    warn "The commit argument '$commit' is deprecated; check out the commit " .
         "and run make-release without it.\n";
}
my $notused = shift;  # Used to be "version".
if (defined $notused) {
    warn "argument '$notused' is ignored.\n";
}
if (defined $tagPoint) {
    warn "option --tagpoint '$tagPoint' is ignored.\n";
}

# Get the top-level project directory.
my $toplevel;
run(["git", "rev-parse", "--show-toplevel"], stdout => \$toplevel, quiet => 1);
if (!$toplevel) {
    die "Unable to find the git top-level directory.\n";
}

# Determine the version.
my $version = find_version($toplevel, $commit);
my $name = "openafs-$version";

# Grab the code into a temporary directory
my $tempDir = File::Temp::tempdir(CLEANUP => 1);
run(["git", "-C", $toplevel, "archive", "--format=tar", "--prefix=$name/", $commit],
    stdout => "$tempDir/$name.tar");
run(["tar", "-C", $tempDir, "-xf", "$tempDir/$name.tar"]);
unlink("$tempDir/$name.tar");

# Make the output path, if not already present.
if ($perVersionDir) {
    $outDir .= "/$version";
}
File::Path::mkpath($outDir);

# Construct the ChangeLog
if ($last) {
    run(["git", "log", "$last..$commit"], stdout => "$outDir/ChangeLog");
} else {
    run(["git", "log", $commit], stdout => "$outDir/ChangeLog");
}

if ($relnotes) {
    # Extract the release notes from the top of the NEWS file.  Include the
    # header lines above the current release, which is the line that starts
    # with "OpenAFS ...", and then all the lines until the start of the next
    # release, which is the next line that starts with "OpenAFS ..."
    my $news = "$tempDir/$name/NEWS";
    my $relnotes = "$outDir/RELNOTES-$version";
    open(my $in_fh, '<', $news) or die "Could not open file '$news' $!\n";
    open(my $out_fh, '>', $relnotes) or die "Could not open file '$relnotes' $!\n";
    my $in_release = 0;
    while (<$in_fh>) {
        if (/^OpenAFS\s+/) {
            last if $in_release;
            $in_release = 1;
        }
        print $out_fh $_;
    }
    close $in_fh;
    close $out_fh;
}

# Describe the tree
open(my $fh, ">", "$tempDir/$name/.version") or
    die "Failed to open $tempDir/$name/.version: $!\n";
print $fh "$version\n";
close($fh);

# Run regen.sh to create the rest of the tree
run(["./regen.sh"], chdir => "$tempDir/$name");

# A list of files to compress
my @toCompress;

# Create the source tarball.
run(["tar", "-cf", "$outDir/$name-src.tar", "-C", $tempDir, $name]);
push @toCompress, "$outDir/$name-src.tar";

if ($docTarball) {
    print "make-release: cp $tempDir/$name/LICENSE $tempDir/$name/doc/\n";
    copy("$tempDir/$name/LICENSE", "$tempDir/$name/doc/")
        or die "Unable to copy LICENSE file to doc directory: $!\n";
    run(["./configure", "-q", "--enable-transarc-paths", "--disable-kernel-module"],
        chdir => "$tempDir/$name");
    run(["make", "man-pages"], chdir => "$tempDir/$name");
    run(["tar", "-cf", "$outDir/$name-doc.tar", "-C", $tempDir, "$name/doc"]);
    push @toCompress, "$outDir/$name-doc.tar";
}

# Construct the diffs, and zip them
if ($last) {
    run(["git", "diff", "$last..$commit"], stdout => "$outDir/$name.diff");
    push @toCompress, "$outDir/$name.diff";
}

my @toMD;

# Compress everything that needs squashing,
# and also set up a list for checksumming.
foreach my $file (@toCompress) {
    foreach my $format (@compress) {
        my $program = $compressors{$format};
        run([$program], stdin => $file, stdout => "$file.$format");
        push @toMD, "$file.$format";
    }

    # Delete the uncompressed tar files.
    if ($file =~ /\.tar$/) {
      unlink($file);
    } else {
      # Otherwise, queue this file for checksumming.
      push @toMD, $file;
    }
}

# Generate message digest files.

my $cwd = getcwd() or die "Failed getcwd(): $!\n";
my $md5 = which('md5');
my $md5sum = which('md5sum');
my $shasum = which("shasum");
my $sha256sum = which("sha256sum");

foreach my $pathname (@toMD) {
    my $directory = dirname($pathname);
    my $file = basename($pathname);

    chdir($directory) or die "Failed cd $directory: $!\n";

    if ($md5) {
        run([$md5, "-q", $file], stdout => "$file.md5", warn => 1)
            or $errorCount += 1;
    } elsif ($md5sum) {
        run([$md5sum, $file], stdout => "$file.md5", warn => 1)
            or $errorCount += 1;
    } else {
        warn "MD5 utility not found. Not producing $file.md5\n";
        $errorCount += 1;
    }

    if ($shasum) {
        run([$shasum, "-a", "256", $file], stdout => "$file.sha256", warn => 1)
            or $errorCount += 1;
    } elsif ($sha256sum) {
        run([$sha256sum, $file], stdout => "$file.sha256", warn => 1)
            or $errorCount += 1;
    } else {
        warn "SHA256 utility program not found. Not producing $file.sha256\n";
        $errorCount += 1;
    }

    chdir($cwd) or die "Failed cd $cwd: $!\n";
}

if ($errorCount != 0) {
    die "Failed to create all files; $errorCount errors encountered.\n";
}

__END__

=head1 NAME

make-release - Make OpenAFS release files from git

=head1 SYNOPSIS

make-release [options] [I<commit>]

 Options:
    --help               brief help message
    --man                full documentation
    --last <object>      generate changelog and diffs from this point
    --relnotes           generate release notes from NEWS file
    --destdir <dir>      base directory to output files
    --per-version-dir    output files into a version subdirectory
    --[no-]doc-tarball   create a doc.tar archive (default)
    --compress <format>  compression format(s) of output archives

=head1 DESCRIPTION

B<make-release> constructs a set of OpenAFS source distribution files from a
local git clone for a given release. It extracts the contents of a commit (the
default is B<HEAD>) with B<git archive> to create the source tarball, and
optionally the doc tarball. The tarballs are then compressed and message
digests are generated for each.

B<make-release> will also create a ChangeLog file, listing all of the changes
in that release, and optionally extract lines from the NEWS file to create a
release notes file.

When the I<commit> is not specified (or is specified as B<HEAD>), the version
of the release files is determined by the B<git-version> script (the same way
the build system determines the version). If a B<.version> file is present in
the top-level project directory, B<git-version> uses its contents as the
version instead of running B<git describe>.

Uncommitted changes in the index or work tree are not included in the release
files, so B<make-release> prints a warning when uncommitted changes are found.

=head1 OPTIONS

=over 8

=item I<commit>

The branch or tag name of the commit to be used to generate the release files.
The default is B<HEAD>.  B<git archive> is run for this commit to create to
create a temporary work tree to create the source archive (and optionally, the
doc archive.)

When I<commit> is given (and is not B<HEAD>) the version is determined by B<git
describe> a B<.version> file is not used and uncommitted changes are not
checked.

Deprecated: Check out the commit and run B<make-release> without this argument
instead.

=item B<--last> I<object>

Generate the ChangeLog starting from I<object>. Also generate a
openafs-$version.diff file in the output directory containing all of the
changes between I<object> and the release commit.

=item B<--relnotes>

Extract the most recent NEWS items to create the release notes file.

=item B<--destdir> I<directory>, B<--dir> I<directory>

Instead of generating all of the output in the current directory, place it
in <directory>, which is created if it does not already exist.

=item B<--per-version-dir>

Place the output in a subdirectory named after the release version, under the
directory given by B<--destdir> (or the current directory if B<--destdir> is
not given).  The subdirectory is created if it does not already exist.

=item B<--tagpoint> I<commit|branch>

Not used.

=item B<--doc-tarball>, B<--no-doc-tarball>

Create, or do not create, a doc.tar archive. B<--doc-tarball> is the
default.

=item B<--compress> I<format>

Specifies the compression format of the compressed archive(s).  Valid I<format>
values are B<gz>, B<bz2>, and B<xz>. This option may be given more than once to
create multiple compressed archives. The default is to create B<gz> and B<bz2>
compressed archives (and not B<xz>).

=back

=cut
