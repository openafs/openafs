#!/usr/bin/perl
use warnings;
use strict;

use Getopt::Long;
use Pod::Usage;
use File::Copy;
use File::Path;
use File::Temp;
use File::Basename;
use Cwd;

my $help;
my $man;
my $tagPoint;
my $last;
my $relnotes = 0;
my $outDir = ".";
my $errorCount = 0;
my $noDocTarball = 0;
my @compress = ();

my %compressors = (
    "gz" => "gzip",
    "bz2" => "bzip2",
    "xz" => "xz",
);

# Format warn messages.
$SIG{__WARN__} = sub {
    my $msg = shift;
    warn "warning: $msg";
};

# Find a command in the PATH.
sub which {
    my $command = shift;
    my @paths = split(/:/, $ENV{'PATH'});
    my $path;

    # Add some common locations for the commands we need.
    push(@paths, qw(/sbin /usr/bin /usr/local/bin));

    # Search for the command.
    foreach $path (@paths) {
        my $bin = File::Spec->catfile($path, $command);
        if (-x $bin) {
            return $bin;  # Return the first one found.
        }
    }
    return undef;
}

# Run a command.
#
# Arguments:
#   args - array reference of command line arguments
#   opts - options:
#      chdir   => directory to change to before running the command
#      stdin   => file name to redirect stdin from
#      stdout  => file name to redirect stdout to, or a scalar
#                 reference to store the output in, without the
#                 trailing newline
#      warn    => if true, warn instead of die if the command fails
#      quiet   => do not print the command before running it
#
# Returns true if the command succeeds. Dies with an error message if the
# command fails, unless the 'warn' option is given, in which case it prints
# the error message and returns false.
#
sub run {
    my ($args, %opts) = @_;
    my $command = join(' ', @$args);

    # Construct a command string for info and error messages.
    if (defined $opts{chdir}) {
        $command = "cd $opts{chdir} && $command";
    }
    if (defined $opts{stdin}) {
        $command .= " < $opts{stdin}";
    }
    if (defined $opts{stdout} && !ref $opts{stdout}) {
        $command .= " > $opts{stdout}";
    }

    # Print the command to be run, unless in quiet mode.
    if (!$opts{quiet}) {
        print "make-release: $command\n";
    }

    # Fork the process and execute the command. Create a pipe to read
    # the command's stdout when capturing output.
    my $fh;
    my $pid;
    if (defined $opts{stdout} && ref $opts{stdout}) {
        $pid = open($fh, '-|');
    } else {
        $pid = fork();
    }
    if (!defined $pid) {
        die "Failed to fork: $!\n";
    }
    if ($pid == 0) {
        # Child process.
        if (defined $opts{chdir}) {
            if (!chdir($opts{chdir})) {
                warn "Failed to change directory to $opts{chdir}: $!\n";
                exit 127;
            }
        }
        if (defined $opts{stdin}) {
            if (!open(STDIN, '<', $opts{stdin})) {
                warn "Failed to open $opts{stdin}: $!\n";
                exit 127;
            }
        }
        if (defined $opts{stdout} && !ref $opts{stdout}) {
            if (!open(STDOUT, '>', $opts{stdout})) {
                warn "Failed to open $opts{stdout}: $!\n";
                exit 127;
            }
        }
        exec { $args->[0] } @$args;
        warn "Failed to execute '$args->[0]': $!\n";
        exit 127;
    }
    # Parent process.
    if (defined $opts{stdout} && ref $opts{stdout}) {
        ${$opts{stdout}} = do { local $/; <$fh> };  # Slurp the output.
        chomp ${$opts{stdout}};
        close($fh);  # Waits for the child and sets $?.
    } else {
        waitpid($pid, 0);
    }

    my $error;
    if ($? & 127) {
        $error = "'$command' died with signal " . ($? & 127) . " ($?)\n";
    } elsif ($? != 0) {
        $error = "'$command' exited with code " . ($? >> 8) . " ($?)\n";
    } else {
        return 1;   # success
    }
    if ($opts{warn}) {
        warn $error;
        return 0;   # failed with warning
    }
    die $error;     # fatal
}

GetOptions(
    "help|?" => \$help,
    "man" => \$man,
    "tagpoint=s" => \$tagPoint,
    "last=s" => \$last,
    "relnotes" => \$relnotes,
    "dir=s" => \$outDir,
    "no-doc-tarball" => \$noDocTarball,
    "compress=s" => \@compress,
) or pod2usage(2);

pod2usage(1) if $help;
pod2usage(-exitstatus => 0, -verbose => 2, -noperldoc => 1) if $man;

if (!@compress) {
    @compress = ("gz", "bz2");  # xz is not created by default.
}
foreach my $format (@compress) {
    if (!exists($compressors{$format})) {
        pod2usage(-exitval => 2, -message => "Unknown compression format: $format");
    }
}

my $tagName = shift;
my $notused = shift;  # Used to be "version".

pod2usage(2) if !defined($tagName);
if (defined $notused) {
    warn "argument '$notused' is ignored.\n";
}

# Tag the repository

if ($tagPoint) {
    run(["git", "tag", "-s", $tagName, $tagPoint]);

    # Push the tag upstream
    run(["git", "push", "ssh://gerrit.openafs.org:29418/openafs", "tag", $tagName]);
}

my $version;
run(["git", "describe", "--abbrev=4", $tagName], stdout => \$version, quiet => 1);
if (!$version) {
    die "Failed to describe $tagName.\n";
}
my $suffix = $version;
$suffix =~ s/openafs-[^-]*-//;
$suffix =~ s/_/./g;
my $name = "openafs-$suffix";

# Get the top-level project directory.
my $toplevel;
run(["git", "rev-parse", "--show-toplevel"], stdout => \$toplevel, quiet => 1);
if (!$toplevel) {
    die "Unable to find the git top-level directory.";
}

# Grab the tagged code into a temporary directory
my $tempDir = File::Temp::tempdir(CLEANUP => 1);
run(["git", "-C", $toplevel, "archive", "--format=tar", "--prefix=$name/", $tagName],
    stdout => "$tempDir/$name.tar");
run(["tar", "-C", $tempDir, "-xf", "$tempDir/$name.tar"]);
unlink("$tempDir/$name.tar");

# Make the output path, if not already present.
File::Path::mkpath($outDir);

# Construct the ChangeLog
if ($last) {
    run(["git", "log", "$last..$tagName"], stdout => "$outDir/ChangeLog");
} else {
    run(["git", "log", $tagName], stdout => "$outDir/ChangeLog");
}

if ($relnotes) {
    # Extract the release notes from the top of the NEWS file.  Include the
    # header lines above the current release, which is the line that starts
    # with "OpenAFS ...", and then all the lines until the start of the next
    # release, which is the next line that starts with "OpenAFS ..."
    my $news = "$tempDir/$name/NEWS";
    my $relnotes = "$outDir/RELNOTES-$suffix";
    open(my $in_fh, '<', $news) or die "Could not open file '$news' $!\n";
    open(my $out_fh, '>', $relnotes) or die "Could not open file '$relnotes' $!\n";
    my $in_release = 0;
    while (<$in_fh>) {
        if (/^OpenAFS\s+/) {
            last if $in_release;
            $in_release = 1;
        }
        print $out_fh $_;
    }
    close $in_fh;
    close $out_fh;
}

# Describe the tree
open(my $fh, ">", "$tempDir/$name/.version") or
    die "Failed to open $tempDir/$name/.version: $!\n";
print $fh "$version\n";
close($fh);

# Run regen.sh to create the rest of the tree
run(["./regen.sh"], chdir => "$tempDir/$name");

# A list of files to compress
my @toCompress;

# Create the source tarball.
run(["tar", "-cf", "$outDir/$name-src.tar", "-C", $tempDir, $name]);
push @toCompress, "$outDir/$name-src.tar";

if (!$noDocTarball) {
    print "make-release: cp $tempDir/$name/LICENSE $tempDir/$name/doc/\n";
    copy("$tempDir/$name/LICENSE", "$tempDir/$name/doc/")
        or die "Unable to copy LICENSE file to doc directory: $!";
    run(["./configure", "-q", "--enable-transarc-paths", "--disable-kernel-module"],
        chdir => "$tempDir/$name");
    run(["make", "man-pages"], chdir => "$tempDir/$name");
    run(["tar", "-cf", "$outDir/$name-doc.tar", "-C", $tempDir, "$name/doc"]);
    push @toCompress, "$outDir/$name-doc.tar";
}

# Construct the diffs, and zip them
if ($last) {
    run(["git", "diff", "$last..$tagName"], stdout => "$outDir/$name.diff");
    push @toCompress, "$outDir/$name.diff";
}

my @toMD;

# Compress everything that needs squashing,
# and also set up a list for checksumming.
foreach my $file (@toCompress) {
    foreach my $format (@compress) {
        my $program = $compressors{$format};
        run([$program], stdin => $file, stdout => "$file.$format");
        push @toMD, "$file.$format";
    }

    # Delete the uncompressed tar files.
    if ($file =~ /\.tar$/) {
      unlink($file);
    } else {
      # Otherwise, queue this file for checksumming.
      push @toMD, $file;
    }
}

# Generate message digest files.

my $cwd = getcwd() or die "Failed getcwd(): $!";
my $md5 = which('md5');
my $md5sum = which('md5sum');
my $shasum = which("shasum");
my $sha256sum = which("sha256sum");

foreach my $pathname (@toMD) {
    my $directory = dirname($pathname);
    my $file = basename($pathname);

    chdir($directory) or die "Failed cd $directory: $!";

    if ($md5) {
        run([$md5, "-q", $file], stdout => "$file.md5", warn => 1)
            or $errorCount += 1;
    } elsif ($md5sum) {
        run([$md5sum, $file], stdout => "$file.md5", warn => 1)
            or $errorCount += 1;
    } else {
        warn "MD5 utility not found. Not producing $file.md5";
        $errorCount += 1;
    }

    if ($shasum) {
        run([$shasum, "-a", "256", $file], stdout => "$file.sha256", warn => 1)
            or $errorCount += 1;
    } elsif ($sha256sum) {
        run([$sha256sum, $file], stdout => "$file.sha256", warn => 1)
            or $errorCount += 1;
    } else {
        warn "SHA256 utility program not found. Not producing $file.sha256";
        $errorCount += 1;
    }

    chdir($cwd) or die "Failed cd $cwd: $!";
}

if ($errorCount != 0) {
    die "Failed to create all files; $errorCount errors encountered.";
}

__END__

=head1 NAME

make-release - Make an OpenAFS release from git

=head1 SYNOPSIS

make-release [options] <tag>

 Options:
    --help               brief help message
    --man                full documentation
    --tagpoint <object>  create new tag
    --last <object>      generate changelog and diffs from this point
    --relnotes           generate release notes from NEWS file
    --dir <dir>          output results into this directory
    --no-doc-tarball     do not create a doc.tar archive
    --compress <format>  compression format(s) of output archives

=head1 DESCRIPTION

make-release constructs an OpenAFS release from a local git clone. If run
with just the standard arguments, it will extract the contents of the
specified tag into the current directory, creating src and doc tarballs,
compressing them, and generating digest files. It will also create a
ChangeLog file, listing all of the changes in that release.

This standard behaviour may be modified by the following options

=head1 OPTIONS

=over 8

=item B<--last> I<object>

Generate the ChangeLog starting from I<object>. Also generate a
openafs-$version.diff file in the output directory containing all of the
changes between I<object> and the current tag

=item B<--relnotes>

Extract the most recent NEWS items to create the release notes file.

=item B<--dir> I<directory>

Instead of generating all of the output in the current directory, place it
in <directory>, which is created if it does not already exist.

=item B<--tagpoint> I<commit|branch>

Rather than using an existing tag, create a new one on the specified commit,
or on the tip of the specified branch. This will GPG sign the new tag, and
push it into gerrit.

=item B<--no-doc-tarball>

Do not create a doc.tar archive.

=item B<--compress> I<format>

Specifies the compression format of the compressed archive(s).  Valid I<format>
values are B<gz>, B<bz2>, and B<xz>. This option may be given more than once to
create multiple compressed archives. The default is to create B<gz> and B<bz2>
compressed archives (and not B<xz>).

=back

=cut
